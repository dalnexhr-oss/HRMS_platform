{
  "name": "dalnex-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "Dalnex HRMS — attendance & payroll admin portal (Next.js + TypeScript + MongoDB)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "db:gen-schema": "node scripts/gen-schema.mjs",
    "db:backfill-names": "node --env-file=.env.local scripts/backfill-employee-names.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "mongodb": "^7.6.0",
    "next": "^15.5.20",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.20",
    "typescript": "^5.7.3"
  }
}
