{
  "name": "dalnex-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "Dalnex HRMS — attendance & payroll admin portal (Next.js + TypeScript + MongoDB)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:device": "node zkteco/commands/run-device.mjs dev",
    "start:device": "node zkteco/commands/run-device.mjs start",
    "device:configure": "node zkteco/cli/configure-device.mjs",
    "device:bridge": "node zkteco/commands/run-device.mjs bridge",
    "device:status": "node zkteco/commands/run-device.mjs status",
    "device:roster": "node zkteco/cli/export-roster.mjs",
    "device:link": "node zkteco/cli/link-employees.mjs",
    "device:onboard": "node zkteco/cli/onboard-employees.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "db:backfill-names": "node --env-file=.env.local scripts/backfill-employee-names.mjs",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "check:names": "node scripts/check-file-names.mjs",
    "check": "npm run format:check && npm run check:names && npm run lint && npm run typecheck",
    "device:inspect": "node zkteco/commands/run-device.mjs inspect",
    "device:sync-users": "node zkteco/commands/run-device.mjs sync-users"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "mongodb": "^7.6.0",
    "next": "^15.5.20",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.20",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "fast-csv": "^5.0.7",
    "glob": "^13.0.6",
    "postcss": "^8.5.28",
    "tmp": "^0.2.7",
    "unzipper": "^0.12.5",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
