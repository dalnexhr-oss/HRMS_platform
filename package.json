{
  "name": "dalnex-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "Dalnex HRMS — attendance & payroll admin portal (Next.js + TypeScript + MongoDB)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "db:backfill-names": "node --env-file=.env.local scripts/backfill-employee-names.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:names": "node scripts/check-file-names.mjs",
    "test": "node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "check": "npm run format:check && npm run check:names && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "mongodb": "^7.6.0",
    "next": "^15.5.20",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.20",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "sharp": "0.34.5",
    "typescript": "^5.7.3"
  }
}
